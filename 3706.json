rma, sona erdirme ve kampanya kapsamında değişiklik yapma hakkını saklı tutar.\n8.Kampanya süresince verilen siparişlerde herhangi bir değişiklik (sipariş iptali/iade, cayma hakkının kullanılması vb.) indirim hakkı kazanma durumunu etkileyebilir.\n9.Kampanya stoklarla sınırlıdır.","HedefKitleKod":"","KampTipi":0,"PromTip":2,"Kez":null,"TuketiciKez":null,"KalanKez":null,"OranTutar":2,"VerilenFayda":20,"KampanyaGorsel":"","KampanyaGorselDikey":"https://asset.chippin.com/kampanyaimage/verdegunsonu/taniwebsite_image/web_1305202511114222_1099535.jpg","KampanyaGorselYatay":"https://asset.chippin.com/kampanyaimage/verdegunsonu/taniwebsite_image/web_1305202511114222_1099535.jpg","KazanilanPuan":null,"KalanPuan":null,"IndirimPuan":0,"BirikimMiktari":0,"TuketiciBirikimMiktari":null,"KalanBirikimMiktari":null,"BaslangicTarih":"2025-04-16T00:00:00","BitisTarih":"2026-12-31T23:59:00","PuanSonKullanimTarih":null,"Katilimli":false,"IsJoined":false,"CekilisAlimaBagli":false,"CekilisTekSeferlik":false,"CekilisKatilimAdet":0,"CekiliseKatildi":false,"IsyeriKod":"1232","YetkiliKod":"2079","SubeKod":""}]}}